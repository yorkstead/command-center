# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---- Google Calendar sync (server only; see README "Calendar sync") ----------
# Where Google sends change pings. Local: http://localhost:3000 (no pings, use "Sync now").
APP_URL=https://cal.yorkstead.com
# Supabase: Project Settings > API Keys > Secret key. Only the calendar sync uses it.
SUPABASE_SECRET_KEY=sb_secret_...
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# The shared "Yorkstead Meetings" calendar: its settings > Integrate calendar > Calendar ID
GOOGLE_CALENDAR_ID=...@group.calendar.google.com
# openssl rand -base64 32   (encrypts the Google refresh token)
TOKEN_ENCRYPTION_KEY=
# openssl rand -hex 32      (Vercel sends it to the daily job)
CRON_SECRET=
# Optional, only if Cal.com bookings should create prospects
CALCOM_WEBHOOK_SECRET=
